{
  "name": "datagrid",
  "version": "0.1.0",
  "description": "DataGrid: a lightweight desktop client for PostgreSQL, DynamoDB and Redis",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder --mac --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "RUN_PG_TESTS=1 vitest run .int.test",
    "test:coverage": "vitest run --coverage",
    "test:ddb": "RUN_DDB_TESTS=1 vitest run .ddb.test",
    "test:redis": "RUN_REDIS_TESTS=1 vitest run redis.int.test",
    "test:e2e": "RUN_E2E=1 vitest run .e2e.test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-sts": "^3.1161.0",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@fontsource/google-sans": "^5.3.2",
    "@fontsource/google-sans-code": "^5.3.2",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "@tanstack/react-table": "^9.3.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "private": true,
  "author": "Tushar Arora",
  "build": {
    "appId": "com.local.datagrid",
    "productName": "DataGrid",
    "copyright": "Copyright © 2026 Tushar Arora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  }
}
